# Local .terraform directories
**/.terraform/*

# Terraform state files
*.tfstate
*.tfstate.*

# Crash log files
crash.log

# CLI configuration files
.terraformrc
terraform.rc

# Sensitive variable files (optional)
*.tfvars
*.tfvars.json

# Plan output
*.plan

# override files (sometimes used for local configs)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Provider-specific cache
.terraform.lock.hcl
terraform-ec2-infrastructure/
